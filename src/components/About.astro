---
import { originStory, whyWeExist } from "../lib/story.content";
---

<section
  id="story"
  aria-labelledby="origin-heading"
  class="bg-background px-4 py-20 sm:px-6 sm:py-24"
>
  <div class="mx-auto max-w-6xl">
    <header class="max-w-5xl">
      <p class="text-xs font-black uppercase tracking-[.25em] text-primary">
        {originStory.eyebrow}
      </p>
      <h2
        id="origin-heading"
        class="mt-3 font-heading text-5xl font-black uppercase leading-[.9] sm:text-7xl lg:text-8xl"
      >
        {originStory.title}
      </h2>
    </header>

    <article class="mt-12">
      <div class="grid gap-8 lg:grid-cols-[.82fr_1.18fr] lg:items-start">
        <div
          class="space-y-5 border-t-4 border-primary pt-6 text-lg leading-relaxed text-foreground/78"
        >
          {originStory.paragraphs.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="grain bg-foreground p-7 text-white sm:p-10">
          <p class="text-sm font-bold uppercase tracking-[.14em] text-accent">
            {originStory.paragraphs[2]}
          </p>
          <p
            class="mt-4 font-heading text-4xl font-black uppercase leading-none sm:text-5xl"
          >
            {originStory.paragraphs[3]}
          </p>
          <p class="mt-6 leading-relaxed text-white/72">
            {originStory.paragraphs[4]}
          </p>
          <div class="my-7 h-px bg-white/25"></div>
          <p class="text-sm font-bold uppercase tracking-[.14em] text-accent">
            {originStory.paragraphs[5]}
          </p>
          <p class="mt-3 font-heading text-4xl font-black uppercase leading-none">
            {originStory.paragraphs[6]}
          </p>
          <p class="mt-5 font-heading text-6xl font-black uppercase text-primary">
            {originStory.paragraphs[7]}
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-8 lg:grid-cols-2">
        <div class="space-y-5 text-lg leading-relaxed text-foreground/76">
          {originStory.paragraphs.slice(8, 10).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-foreground/76">
          <p class="font-heading text-4xl font-black uppercase leading-none text-primary">
            {originStory.paragraphs[10]}
          </p>
          <p>{originStory.paragraphs[11]}</p>
        </div>
      </div>

      <div
        class="mt-12 border-l-8 border-accent bg-primary p-7 text-white sm:p-10"
      >
        <p class="text-sm font-black uppercase tracking-[.16em] text-accent">
          {originStory.paragraphs[12]}
        </p>
        <p
          class="mt-4 max-w-4xl font-heading text-4xl font-black uppercase leading-none sm:text-5xl"
        >
          {originStory.paragraphs[13]}
        </p>
        <p
          class="mt-8 border-t-2 border-white/45 pt-6 font-heading text-3xl font-black uppercase sm:text-4xl"
        >
          {originStory.paragraphs[14]}
        </p>
      </div>
    </article>
  </div>
</section>

<section
  id="purpose"
  aria-labelledby="purpose-heading"
  class="bg-secondary px-4 py-20 text-white sm:px-6 sm:py-24"
>
  <div class="mx-auto max-w-6xl">
    <header class="max-w-5xl">
      <p class="text-xs font-black uppercase tracking-[.25em] text-accent">
        {whyWeExist.eyebrow}
      </p>
      <h2
        id="purpose-heading"
        class="mt-3 font-heading text-5xl font-black uppercase leading-[.9] sm:text-7xl lg:text-8xl"
      >
        {whyWeExist.title}
      </h2>
    </header>

    <article class="mt-10">
      <div
        class="border-l-4 border-primary bg-white/7 p-7 text-lg leading-relaxed text-white/78 sm:p-10 lg:columns-2 lg:gap-12"
      >
        {
          whyWeExist.paragraphs.slice(0, 4).map((paragraph, index) => (
            <p
              class:list={[
                "mb-5 break-inside-avoid last:mb-0",
                index === 2 && "font-extrabold text-white",
              ]}
            >
              {paragraph}
            </p>
          ))
        }
      </div>

      <div
        class="mt-3 border-y-2 border-accent bg-foreground px-6 py-9 text-center sm:px-10"
      >
        <p class="text-sm font-black uppercase tracking-[.18em] text-accent">
          {whyWeExist.paragraphs[4]}
        </p>
        <p
          class="mt-4 font-heading text-5xl font-black uppercase leading-none sm:text-7xl"
        >
          {whyWeExist.paragraphs[5]}
        </p>
      </div>

      <div
        class="mt-3 border border-white/25 bg-white/7 p-7 text-lg leading-relaxed text-white/78 sm:p-10 lg:columns-2 lg:gap-12"
      >
        <p class="mb-5 break-inside-avoid">{whyWeExist.paragraphs[6]}</p>
        <p
          class="mb-5 break-inside-avoid border-l-4 border-primary pl-5 font-extrabold text-white"
        >
          {whyWeExist.paragraphs[7]}
        </p>
        <p class="break-inside-avoid">{whyWeExist.paragraphs[8]}</p>
      </div>

      <div
        class="mt-3 border-2 border-white/35 p-7 text-lg leading-relaxed text-white/78 sm:p-10"
      >
        <div class="max-w-4xl">
          <p class="font-extrabold text-white">{whyWeExist.paragraphs[9]}</p>
          <p class="mt-5">{whyWeExist.paragraphs[10]}</p>
        </div>
        <div class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {
            whyWeExist.paragraphs.slice(11, 15).map((paragraph, index) => (
              <p
                class:list={[
                  "flex min-h-24 items-center border-l-4 px-5 py-4 font-heading text-2xl font-black uppercase leading-tight",
                  index === 3
                    ? "border-accent bg-accent text-foreground"
                    : "border-primary bg-white/7",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>

      <div class="mt-3 border-l-4 border-accent bg-foreground/40 p-7 sm:p-10">
        <p class="max-w-4xl text-lg leading-relaxed text-white/78">
          {whyWeExist.paragraphs[15]}
        </p>
      </div>

      <div class="mt-3 grid gap-3 lg:grid-cols-2">
        <p
          class="flex min-h-48 items-center bg-accent p-7 font-heading text-4xl font-black uppercase leading-none text-foreground sm:p-10"
        >
          {whyWeExist.paragraphs[16]}
        </p>
        <p
          class="flex min-h-48 items-center border-2 border-white/35 p-7 font-heading text-4xl font-black uppercase leading-none sm:p-10"
        >
          {whyWeExist.paragraphs[17]}
        </p>
      </div>

      <p
        class="mt-3 bg-primary p-7 text-center font-heading text-4xl font-black uppercase leading-none sm:p-10 sm:text-6xl"
      >
        {whyWeExist.paragraphs[18]}
      </p>
    </article>
  </div>
</section>
