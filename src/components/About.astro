---
const audiences = [
  { label: "Alumni", caption: "Reconnect in Colorado." },
  { label: "Transplants", caption: "Find familiar colors." },
  { label: "Families + Fans", caption: "Everyone can rally." },
];
---

<section id="about" class="bg-background px-4 py-20 sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <p class="text-xs font-black uppercase tracking-[.25em] text-primary">
          About the club
        </p>
        <h2
          class="mt-3 font-heading text-5xl font-black uppercase leading-[.9] sm:text-7xl sm:leading-none"
        >
          Ferris pride,<br />raised higher.
        </h2>
      </div>
      <div class="text-lg leading-relaxed text-foreground/70">
        <p>
          Mile High Bulldogs connects Colorado-based Ferris alumni, transplants,
          families, and fans through shared school pride, social community, and
          game-day events.
        </p>
        <p class="mt-4 font-extrabold text-foreground">
          Show up in crimson. Meet your people. Keep the Bulldog spirit loud.
        </p>
      </div>
    </div>

    <div class="mt-12 grid gap-3 sm:grid-cols-3">
      {
        audiences.map((item) => (
          <div class="border-2 border-foreground p-5">
            <strong class="font-heading text-3xl uppercase">{item.label}</strong>
            <p class="mt-1 text-sm text-foreground/60">{item.caption}</p>
          </div>
        ))
      }
    </div>

    <div
      class="mt-3 bg-primary p-7 text-white sm:flex sm:items-center sm:justify-between sm:gap-8"
    >
      <p class="font-heading text-3xl font-bold uppercase">
        “Add an approved member quote about finding Ferris community in
        Colorado.”
      </p>
      <p
        class="mt-4 shrink-0 text-[10px] font-bold uppercase tracking-[.2em] text-accent sm:mt-0"
      >
        Client-supplied testimonial
      </p>
    </div>
  </div>
</section>
