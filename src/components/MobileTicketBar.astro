---
// Sticky bottom bar, mobile only. The body carries pb-16 below md so content is
// never hidden behind it.
import { siteConfig } from "../lib/site.config";
---

<a
  href={siteConfig.ticketUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed inset-x-3 bottom-3 z-50 bg-accent px-5 py-4 text-center text-sm font-black uppercase tracking-[.18em] text-foreground shadow-2xl md:hidden"
>
  {siteConfig.ticketLabel} · {siteConfig.event.dateShort}
</a>
