---
import ArrowIcon from "./ArrowIcon.astro";
import { swagContact } from '../lib/swag';
---

<dialog id="swag-order" aria-labelledby="order-title" aria-describedby="order-description">
  <div class="order-heading">
    <p>{swagContact.business}</p>
    <button type="button" class="order-close" aria-label="Close order details" autofocus>Close ×</button>
    <h2 id="order-title">Order with {swagContact.name}.</h2>
  </div>
  <div class="order-body">
    <div class="selected-product">
      <img id="order-image" alt="" width="112" height="112" />
      <div><p class="product-label">Your pick</p><h3 id="order-product"></h3></div>
    </div>
    <p id="order-description">Call or email Loni to order this item. She’ll help you confirm sizes, availability, and payment.</p>
    <div class="contact-options">
      <a class="call-link" href={swagContact.phoneHref}><span>Call {swagContact.name} <ArrowIcon /></span><strong>{swagContact.phone}</strong></a>
      <a id="order-email" class="email-link" href={`mailto:${swagContact.email}`}><span>Email {swagContact.name} <ArrowIcon /></span><strong>{swagContact.email}</strong></a>
    </div>
    <p class="email-note">Your email will include the product name. Just add your size and quantity.</p>
  </div>
</dialog>

<script>
  const orderDialog = document.querySelector<HTMLDialogElement>('#swag-order');
  const product = document.querySelector('#order-product');
  const productImage = document.querySelector<HTMLImageElement>('#order-image');
  const email = document.querySelector<HTMLAnchorElement>('#order-email');
  let orderOpener: HTMLAnchorElement | null = null;
  let previousOverflow = '';

  if (orderDialog && product && productImage && email && typeof orderDialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-order]').forEach(link => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', 'swag-order');
      link.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        product.textContent = link.dataset.product ?? '';
        productImage.style.visibility = 'hidden';
        productImage.onload = () => { productImage.style.visibility = ''; };
        productImage.src = link.dataset.image ?? '';
        productImage.alt = link.dataset.alt ?? '';
        email.href = link.href;
        orderOpener = link;
        previousOverflow = document.body.style.overflow;
        orderDialog.showModal();
        event.preventDefault();
        document.body.style.overflow = 'hidden';
      });
    });
    orderDialog.querySelector('.order-close')?.addEventListener('click', () => orderDialog.close());
    orderDialog.addEventListener('click', event => {
      // Only dismiss clicks outside the panel, not padding inside it.
      if (event.target !== orderDialog) return;
      const rect = orderDialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) orderDialog.close();
    });
    orderDialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      orderOpener?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  dialog { margin: auto; width: min(580px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 0; border: 2px solid var(--color-foreground); background: var(--color-background); color: var(--color-foreground); }
  dialog::backdrop { background: rgb(20 23 32 / .88); }
  .order-heading { position: relative; padding: 30px; background: var(--color-secondary); color: white; border-bottom: 6px solid var(--color-accent); }
  .order-heading > p { padding-right: 85px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .13em; color: var(--color-accent); }
  .order-heading h2 { margin-top: 20px; font-family: var(--font-heading); font-size: clamp(36px, 8vw, 54px); font-weight: 800; line-height: 1; text-transform: uppercase; }
  .order-close { position: absolute; right: 20px; top: 17px; min-height: 44px; padding: 10px; border: 1px solid #ffffff80; font-size: 12px; font-weight: 700; cursor: pointer; }
  .order-close:hover { background: var(--color-accent); color: var(--color-foreground); }
  .order-body { padding: 28px 30px; }
  .selected-product { display: flex; align-items: center; gap: 20px; padding-bottom: 22px; margin-bottom: 20px; border-bottom: 1px solid #36343530; }
  .selected-product img { width: 112px; height: 112px; flex-shrink: 0; object-fit: contain; background: #e8e6df; }
  .product-label { font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .selected-product h3 { margin-top: 7px; font-family: var(--font-heading); font-size: 28px; font-weight: 800; line-height: 1.05; text-transform: uppercase; }
  #order-description { font-size: 14px; line-height: 1.7; }
  .contact-options { display: grid; gap: 12px; margin-top: 22px; }
  .contact-options a { display: grid; gap: 5px; padding: 16px 18px; border: 2px solid var(--color-foreground); }
  .contact-options a > span { display: flex; justify-content: space-between; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .contact-options strong { font-size: 17px; overflow-wrap: anywhere; }
  .contact-options .call-link { background: var(--color-primary); border-color: var(--color-primary); color: white; }
  .contact-options .call-link:hover { background: var(--color-secondary); border-color: var(--color-secondary); }
  .contact-options .email-link:hover { background: var(--color-accent); }
  .email-note { font-size: 11px; line-height: 1.6; color: var(--color-muted); margin-top: 16px; }
  @media (max-width: 420px) { .order-heading { padding: 24px 20px; } .order-body { padding: 22px 20px; } .selected-product { gap: 14px; } .selected-product img { width: 80px; height: 80px; } .selected-product h3 { font-size: 24px; } .contact-options strong { font-size: 15px; } }
</style>
