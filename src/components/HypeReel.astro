---
// Video placeholder — approved alumni footage to be supplied by the client.
---

<section id="reel" class="bg-foreground px-4 py-20 text-white sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div
      role="img"
      aria-label="Hype reel placeholder awaiting approved Mile High Bulldogs video"
      class="grain relative grid min-h-[390px] place-items-center overflow-hidden border-4 border-accent bg-primary p-8 text-center"
    >
      <div
        class="absolute inset-x-0 top-8 -rotate-3 bg-foreground py-3 text-sm font-black uppercase tracking-[.35em]"
      >
        Hype Reel · Video Placeholder
      </div>
      <div>
        <div
          class="mx-auto grid h-24 w-24 place-items-center border-4 border-white text-4xl"
          aria-hidden="true"
        >
          ▶
        </div>
        <h2
          class="mt-6 font-heading text-5xl font-black uppercase sm:text-7xl"
        >
          Turn It Up.
        </h2>
        <p class="mt-3 text-sm text-white/70">
          Approved alumni footage and final video asset to be supplied.
        </p>
      </div>
    </div>
  </div>
</section>
