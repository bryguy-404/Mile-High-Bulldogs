---
import { Image } from "astro:assets";
import { cmsImage } from "../lib/cms-image";
import { siteConfig } from "../lib/site.config";

const { event } = siteConfig;
const [homeLogo, awayLogo] = await Promise.all([cmsImage(event.teams.home.image), cmsImage(event.teams.away.image)]);
---

<section id="event" class="bg-white px-4 py-20 sm:px-6">
  <div
    class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[.82fr_1.18fr] lg:items-stretch"
  >
    <div class="grid min-w-0 gap-5">
      <div
        class="flex min-h-[260px] flex-col items-center justify-center border-4 border-secondary bg-background px-5 py-10 text-center sm:min-h-[300px]"
      >
        <p class="text-xs font-black uppercase tracking-[.25em] text-primary">
          {event.calendarLabel}
        </p>
        <p
          class="mt-5 font-heading text-8xl font-black uppercase leading-[.72] text-secondary sm:text-9xl lg:text-[8.5rem]"
        >
          <span class="block">{event.dateBadge}</span>
          <span class="mt-6 block text-primary">{event.year}</span>
        </p>
      </div>

      <figure
        class="relative aspect-[3/4] overflow-hidden border-4 border-foreground bg-secondary lg:aspect-auto lg:min-h-[360px]"
      >
        <img
          src={event.image}
          alt={event.imageAlt}
          width="1104"
          height="1472"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[50%_30%]"
        />
        <figcaption
          class="absolute inset-x-0 bottom-0 bg-accent px-4 py-3 text-xs font-black uppercase tracking-[.18em] text-foreground"
        >
          {event.imageCaption}
        </figcaption>
      </figure>
    </div>

    <div
      class="flex min-w-0 flex-col border-l-8 border-accent bg-foreground p-7 text-white sm:p-10"
    >
      <p class="text-xs font-bold uppercase tracking-[.2em] text-white/55">
        {event.eyebrow}
      </p>
      <h2 class="mt-5">
        <span class="sr-only">{event.matchup}</span>
        <span
          aria-hidden="true"
          class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-4 border-y border-white/20 py-5 sm:gap-7"
        >
          <Image
            src={homeLogo}
            alt={event.teams.home.imageAlt}
            widths={[180, 280, 360]}
            sizes="(min-width: 640px) 240px, 38vw"
            loading="lazy"
            decoding="async"
            class="mx-auto h-24 w-full object-contain sm:h-32"
          />
          <span class="font-heading text-4xl font-black uppercase text-accent sm:text-5xl">
            {event.versusLabel}
          </span>
          <Image
            src={awayLogo}
            alt={event.teams.away.imageAlt}
            widths={[180, 280, 360]}
            sizes="(min-width: 640px) 240px, 38vw"
            loading="lazy"
            decoding="async"
            class="mx-auto h-24 w-full object-contain sm:h-32"
          />
        </span>
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/72">
        {event.description}
      </p>

      <dl class="mt-8 grid gap-px bg-white/15 sm:grid-cols-2">
        <div class="bg-foreground p-4">
          <dt class="text-[10px] font-black uppercase tracking-[.2em] text-accent">
            {event.labels.game}
          </dt>
          <dd class="mt-1 font-heading text-2xl font-black uppercase">
            {event.date} · {event.time}
          </dd>
        </div>
        <div class="bg-foreground p-4">
          <dt class="text-[10px] font-black uppercase tracking-[.2em] text-accent">
            {event.labels.venue}
          </dt>
          <dd class="mt-1 font-heading text-2xl font-black uppercase">
            {event.venue}
          </dd>
        </div>
        <div class="bg-foreground p-4">
          <dt class="text-[10px] font-black uppercase tracking-[.2em] text-accent">
            {event.labels.pregame}
          </dt>
          <dd class="mt-1 font-heading text-2xl font-black uppercase">
            {event.pregame}
          </dd>
        </div>
        <div class="bg-foreground p-4">
          <dt class="text-[10px] font-black uppercase tracking-[.2em] text-accent">
            {event.labels.deadline}
          </dt>
          <dd class="mt-1 font-heading text-2xl font-black uppercase">
            {event.ticketDeadline}
          </dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
        <a
          href={siteConfig.ticketUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-primary px-7 py-4 text-center text-sm font-black uppercase tracking-[.16em] hover:bg-accent hover:text-foreground"
        >
          {siteConfig.ticketLabel} →
        </a>
        <a
          href={siteConfig.flyerUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-white px-7 py-[14px] text-center text-sm font-black uppercase tracking-[.16em] hover:bg-white hover:text-foreground"
        >
          {event.flyerLabel} ↗
        </a>
      </div>

      <div class="mt-auto pt-8 text-xs leading-relaxed text-white/62">
        <p>{event.contact.prompt}</p>
        <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
          <span class="font-bold text-white">{event.contact.name}</span>
          <a
            href={`mailto:${event.contact.email}`}
            class="break-all font-bold text-white underline decoration-accent underline-offset-4"
          >
            {event.contact.email}
          </a>
          <a
            href={event.contact.phoneHref}
            class="font-bold text-white underline decoration-accent underline-offset-4"
          >
            {event.contact.phone}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
