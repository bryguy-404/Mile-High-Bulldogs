---
import { siteConfig } from "../lib/site.config";
---

<section id="social" class="bg-primary px-4 py-16 text-white sm:px-6">
  <div
    class="mx-auto flex max-w-6xl flex-col justify-between gap-8 lg:flex-row lg:items-center"
  >
    <div>
      <p class="text-xs font-bold uppercase tracking-[.25em] text-accent">
        Keep the rally going
      </p>
      <h2 class="mt-2 font-heading text-5xl font-black uppercase sm:text-6xl">
        Find your Bulldogs.
      </h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/72">
        Follow the next gathering, reconnect with Ferris friends, and welcome
        another Bulldog into the Colorado community.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={siteConfig.facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white px-6 py-4 text-center text-sm font-black uppercase tracking-wider text-foreground"
      >
        Facebook Group ↗
      </a>
      <a
        href={siteConfig.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border-2 border-white px-6 py-4 text-center text-sm font-black uppercase tracking-wider"
      >
        Instagram ↗
      </a>
      <a
        href={siteConfig.ticketUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent px-6 py-4 text-center text-sm font-black uppercase tracking-wider text-foreground"
      >
        Get Tickets
      </a>
    </div>
  </div>

</section>
