---
import { Image } from "astro:assets";
import { galleryContent } from "../lib/homepage-content";
import { cmsImage } from "../lib/cms-image";

// Layout and cropping stay in code. CMS fields only replace these fixed slots.
const tileLayout = [
  { span: "md:col-span-7", minHeight: "md:min-h-[22rem]", objectPosition: "md:object-center" },
  { span: "md:col-span-5", minHeight: "md:min-h-[22rem]", objectPosition: "md:object-[50%_10%]" },
  { span: "md:col-span-5", minHeight: "md:min-h-[20rem]", objectPosition: "md:object-[50%_15%]" },
  { span: "md:col-span-7", minHeight: "md:min-h-[20rem]", objectPosition: "md:object-[50%_18%]" },
];
const tiles = await Promise.all(Object.values(galleryContent.featured).map(async (photo, index) => ({
  ...tileLayout[index], src: await cmsImage(photo.image), alt: photo.imageAlt,
})));
const communityPhotos = await Promise.all(Object.values(galleryContent.moments).map(async photo => ({
  src: await cmsImage(photo.image), alt: photo.imageAlt,
})));
---

<section id="gallery" class="bg-secondary px-4 py-20 text-white sm:px-6">
  <div class="mx-auto max-w-7xl">
    <div
      class="mb-9 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
    >
      <div>
        <p class="text-xs font-black uppercase tracking-[.25em] text-accent">
          {galleryContent.eyebrow}
        </p>
        <h2
          class="mt-2 font-heading text-5xl font-black uppercase sm:text-7xl"
        >
          {galleryContent.title}
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-white/68">
        {galleryContent.description}
      </p>
    </div>

    <div class="grid gap-3 md:grid-cols-12">
      {
        tiles.map((tile) => (
          <figure
            class:list={[
              "group relative overflow-hidden border-2 border-white/35 bg-foreground",
              tile.minHeight,
              tile.span,
            ]}
          >
            <Image
              src={tile.src}
              alt={tile.alt}
              widths={[480, 720, 1080, 1440]}
              sizes="(min-width: 768px) 58vw, 100vw"
              loading="lazy"
              decoding="async"
              class:list={[
                "block h-auto w-full md:absolute md:inset-0 md:h-full md:object-cover md:transition-transform md:duration-500 md:group-hover:scale-[1.02]",
                tile.objectPosition,
              ]}
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-14 border-t-2 border-accent pt-8">
      <div class="mb-7 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <h3 class="font-heading text-3xl font-black uppercase sm:text-4xl">
          {galleryContent.moreTitle}
        </h3>
        <p class="text-xs font-black uppercase tracking-[.2em] text-accent">
          {galleryContent.moreSubtitle}
        </p>
      </div>

      <div class="columns-1 gap-3 sm:columns-2 lg:columns-3 xl:columns-4">
        {
          communityPhotos.map((photo) => (
            <figure class="mb-3 flex break-inside-avoid justify-center overflow-hidden border-2 border-white/35 bg-foreground p-2">
              <Image
                src={photo.src}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
                class="block h-auto w-auto max-w-full"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
