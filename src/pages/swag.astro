---
import ArrowIcon from "../components/ArrowIcon.astro";
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SwagOrderDialog from '../components/SwagOrderDialog.astro';
import { swag, swagOrderEmail } from '../lib/swag';
const [tee, ...collection] = swag;
---

<Layout title="Bulldog Swag | Mile High Bulldogs" description="Take a look at the Mile High Bulldogs collection: tees, crewnecks, quarter-zips, and headwear with Colorado roots and Ferris State pride.">
  <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
  <Header />
  <main id="main">
    <section class="swag-intro">
      <div class="wrap">
        <a class="back-link" href="/"><ArrowIcon direction="left" /> Back to Bulldog Country</a>
        <div class="intro-line">
          <h1>Bulldog pride.<br /><span>Mile High style.</span></h1>
          <div class="intro-copy">
            <p>From game day to every day. A first look at the gear that brings Ferris pride to Colorado.</p>
            <span class="preview-label">The swag collection · Order with Loni</span>
          </div>
        </div>
      </div>
    </section>

    <section class="collection wrap" aria-label="Mile High Bulldogs swag collection">
      <article class="featured">
        <a href={`/images/swag/${tee.id}.webp`} class="product-image featured-image" data-preview data-title={tee.type} aria-label={`Enlarge ${tee.type}`}>
          <img src={`/images/swag/${tee.id}.webp`} alt={tee.alt} width="1500" height="681" fetchpriority="high" />
          <span class="zoom-label" aria-hidden="true">Take a closer look <ArrowIcon /></span>
        </a>
        <div class="featured-copy">
          <p class="eyebrow">{tee.brand} · The everyday essential</p>
          <h2>{tee.name}</h2>
          <p>{tee.description}</p>
          <div class="product-meta"><span>{tee.size}</span><span><strong>${tee.price}</strong> retail</span></div>
          <div class="product-actions">
            <a class="order-button" href={swagOrderEmail(tee.type)} data-order data-product={tee.type} data-image={`/images/swag/${tee.id}.webp`} data-alt={tee.alt}>Order Now <span class="sr-only">— {tee.type}</span><ArrowIcon /></a>
            <a class="sheet-link" href={`/downloads/swag/${tee.id}.pdf`} target="_blank" rel="noopener noreferrer">View product sheet <span class="sr-only">for {tee.type}</span><ArrowIcon /><small>PDF</small></a>
          </div>
        </div>
      </article>

      <div class="collection-heading" data-reveal>
        <h2>The rest of the lineup.</h2>
        <p>Layer up. Head out. Rep your Bulldogs.</p>
      </div>
      <div class="product-grid">
        {collection.map((item) => (
          <article class="product" data-reveal>
            <a href={`/images/swag/${item.id}.webp`} class:list={['product-image', { 'headwear-image': ['00195', '21595'].includes(item.id) }]} data-preview data-title={item.name} aria-label={`Enlarge ${item.name}`}>
              <img src={`/images/swag/${item.id}.webp`} alt={item.alt} width="1200" height="1200" loading="lazy" decoding="async" />
              <span class="zoom-label" aria-hidden="true">Closer look <ArrowIcon /></span>
            </a>
            <div class="product-info">
              <p class="eyebrow">{item.brand} · {item.type}</p>
              <div class="product-title"><h3>{item.name}</h3><span class="price"><strong>${item.price}</strong><small>Retail</small></span></div>
              <p class="description">{item.description}</p>
              <p class="size">{item.size}</p>
              <div class="product-actions">
                <a class="order-button" href={swagOrderEmail(item.name)} data-order data-product={item.name} data-image={`/images/swag/${item.id}.webp`} data-alt={item.alt}>Order Now <span class="sr-only">— {item.name}</span><ArrowIcon /></a>
                <a class="sheet-link" href={`/downloads/swag/${item.id}.pdf`} target="_blank" rel="noopener noreferrer">View product sheet <span class="sr-only">for {item.name}</span><ArrowIcon /><small>PDF</small></a>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="collection-note">
        <p class="font-heading">Once a Bulldog. Always a Bulldog.</p>
        <p>Found your gear? Select Order Now to call or email Loni at Dezigns with Loni LLC. She’ll help you confirm sizes, availability, and payment.</p>
      </div>
    </section>
  </main>
  <Footer />
  <SwagOrderDialog />
  <dialog id="swag-preview" aria-labelledby="preview-title">
    <div class="preview-bar"><h2 id="preview-title"></h2><button type="button" id="close-preview" aria-label="Close enlarged image">Close ×</button></div>
    <img id="preview-image" alt="" />
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#swag-preview');
  const image = document.querySelector<HTMLImageElement>('#preview-image');
  const title = document.querySelector('#preview-title');
  let opener: HTMLAnchorElement | null = null;
  if (dialog && image && title) {
    document.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach(link => {
      link.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        title.textContent = link.dataset.title ?? '';
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      });
    });
    document.querySelector('#close-preview')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { document.body.style.overflow = ''; opener?.focus({ preventScroll: true }); });
  }

  const groups = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  if ('IntersectionObserver' in window && !motion.matches) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => { if (entry.isIntersecting) { entry.target.classList.remove('waiting'); observer.unobserve(entry.target); } });
    }, { threshold: 0.08 });
    groups.forEach(group => {
      observer.observe(group);
      if (group.getBoundingClientRect().top > innerHeight) group.classList.add('waiting');
      group.addEventListener('focusin', () => group.classList.remove('waiting'));
    });
    motion.addEventListener('change', () => { if (motion.matches) { observer.disconnect(); groups.forEach(group => group.classList.remove('waiting')); } });
  }
</script>

<style>
  .wrap { max-width: 1280px; margin-inline: auto; padding-inline: 36px; }
  .swag-intro { background: var(--color-secondary); color: white; padding: 30px 0 54px; border-bottom: 8px solid var(--color-accent); }
  .back-link { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: #fff; }
  .back-link:hover { color: var(--color-accent); }
  .intro-line { display: grid; grid-template-columns: 1.4fr 1fr; gap: 36px; align-items: end; margin-top: 36px; }
  h1,h2,h3 { font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; }
  h1 { font-size: clamp(3.6rem, 6.7vw, 6rem); line-height: .9; letter-spacing: -.025em; }
  h1 span { color: var(--color-accent); }
  .intro-copy { max-width: 370px; justify-self: end; }
  .intro-copy p { font-size: 16px; line-height: 1.7; }
  .preview-label { display: inline-block; margin-top: 20px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .17em; color: var(--color-accent); }
  .collection { padding-top: 48px; padding-bottom: 48px; }
  .featured { display: grid; grid-template-columns: 1.6fr 1fr; border: 2px solid var(--color-foreground); background: white; }
  .product-image { display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; background: #e8e6df; cursor: zoom-in; }
  .product-image img { width: 100%; height: 100%; object-fit: contain; transition: transform 300ms ease; }
  .product-image:hover img { transform: scale(1.025); }
  .featured-image img { height: auto; }
  .zoom-label { position: absolute; right: 12px; bottom: 12px; padding: 8px 11px; background: var(--color-foreground); color: white; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .featured-copy { padding: 30px; align-self: center; }
  .eyebrow { font-size: 11px; line-height: 1.6; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: var(--color-secondary); }
  .featured-copy h2 { font-size: clamp(2rem, 3.5vw, 3.25rem); line-height: .95; margin: 14px 0 18px; }
  .featured-copy > p:not(.eyebrow), .description { font-size: 14px; line-height: 1.75; color: var(--color-muted); }
  .product-meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 20px 0; font-size: 12px; }
  .product-meta strong { font-family: var(--font-heading); font-size: 30px; }
  .sheet-link { display: inline-flex; gap: 8px; align-items: center; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; border-bottom: 2px solid var(--color-primary); padding: 8px 0; }
  .sheet-link:hover { color: var(--color-primary); }
  .sheet-link small { font-size: 9px; font-weight: 600; color: var(--color-muted); }
  .product-actions { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin-top: 18px; }
  .order-button { display: inline-flex; align-items: center; justify-content: center; gap: 18px; min-height: 48px; padding: 14px 20px; background: var(--color-primary); color: white; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
  .order-button:hover { background: var(--color-secondary); }
  .collection-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding-top: 64px; padding-bottom: 24px; }
  .collection-heading h2 { font-size: clamp(2.3rem, 4vw, 3.5rem); line-height: 1; }
  .collection-heading p { font-size: 13px; color: var(--color-muted); }
  .product-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px 32px; }
  .product { border-top: 3px solid var(--color-foreground); }
  .product > .product-image { aspect-ratio: 1; }
  .product > .headwear-image { aspect-ratio: 1.65; }
  .product-info { padding-top: 20px; }
  .product-title { display: flex; justify-content: space-between; align-items: start; gap: 18px; margin: 8px 0 12px; }
  .product-title h3 { font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1; }
  .price { display: grid; text-align: right; flex-shrink: 0; }
  .price strong { font-family: var(--font-heading); font-size: 32px; line-height: 1; }
  .price small { font-size: 9px; text-transform: uppercase; letter-spacing: .1em; margin-top: 4px; color: var(--color-muted); }
  .description { max-width: 490px; }
  .size { font-size: 12px; font-weight: 700; margin: 14px 0 6px; }
  .collection-note { border-top: 3px solid var(--color-foreground); margin-top: 56px; padding-top: 26px; display: flex; justify-content: space-between; gap: 24px; align-items: center; }
  .collection-note .font-heading { font-size: 28px; line-height: 1; font-weight: 800; text-transform: uppercase; }
  .collection-note p:last-child { max-width: 430px; font-size: 12px; line-height: 1.7; color: var(--color-muted); }
  dialog { margin: auto; width: min(1000px, 94vw); max-height: 94dvh; padding: 16px; border: 2px solid var(--color-foreground); background: var(--color-background); }
  dialog::backdrop { background: rgb(20 23 32 / .88); }
  .preview-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 14px; }
  .preview-bar h2 { font-size: 24px; line-height: 1; }
  .preview-bar button { flex-shrink: 0; border: 2px solid var(--color-foreground); padding: 10px 14px; font-size: 12px; font-weight: 800; cursor: pointer; }
  .preview-bar button:hover { background: var(--color-accent); }
  #preview-image { width: 100%; max-height: 76dvh; object-fit: contain; }
  [data-reveal] { transition: opacity 700ms ease, transform 700ms cubic-bezier(.22,1,.36,1); }
  [data-reveal].waiting { opacity: 0; transform: translateY(28px); }
  @media (max-width: 900px) { .featured { grid-template-columns: 1fr; } .featured-copy { padding: 24px; } .featured-image img { width: 100%; } .intro-line { grid-template-columns: 1fr; gap: 22px; } .intro-copy { justify-self: start; max-width: 600px; } .preview-label { margin-top: 12px; } }
  @media (max-width: 600px) { .wrap { padding-inline: 16px; } .swag-intro { padding-bottom: 32px; } .intro-line { margin-top: 28px; } .intro-copy p { font-size: 14px; } .collection { padding-top: 28px; } .product-grid { grid-template-columns: 1fr; gap: 36px; } .collection-heading { display: block; padding-top: 40px; } .collection-heading p { margin-top: 12px; } .collection-note { display: block; } .collection-note p:last-child { margin-top: 16px; } [data-reveal].waiting { transform: translateY(18px); } }
  @media (prefers-reduced-motion: reduce) { [data-reveal], .product-image img { transition: none; } [data-reveal].waiting { opacity: 1; transform: none; } .product-image:hover img { transform: none; } }
</style>
