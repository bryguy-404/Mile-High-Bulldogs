---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import FeaturedEvent from "../components/FeaturedEvent.astro";
import About from "../components/About.astro";
import Gallery from "../components/Gallery.astro";
import SocialCta from "../components/SocialCta.astro";
import Footer from "../components/Footer.astro";
import MobileTicketBar from "../components/MobileTicketBar.astro";
---

<Layout
  title="Mile High Bulldogs | Ferris State Alumni in Colorado"
  description="Mile High Bulldogs brings Ferris State alumni, families, and fans together in Colorado—more than 1,200 miles from Big Rapids and still Bulldog Country."
>
  <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>

  <Header />

  <main id="main">
    <Hero />
    <Marquee />
    <FeaturedEvent />
    <About />
    <Gallery />
    <SocialCta />
  </main>

  <Footer />
  <MobileTicketBar />
</Layout>
